-- СКИНЫ ПЕРСОНАЖА
local charOriginals = {}

local function resetCharSkin()
    for part, data in pairs(charOriginals) do
        if part.Parent then
            part.Color, part.Material, part.Transparency = data.c, data.m, data.t
        end
    end
    charOriginals = {}
end

local function applyCharSkin(color, material, transparency)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if not charOriginals[part] then
                charOriginals[part] = {c = part.Color, m = part.Material, t = part.Transparency}
            end
            part.Color = color
            part.Material = material
            if transparency then part.Transparency = transparency end
        end
    end
end

