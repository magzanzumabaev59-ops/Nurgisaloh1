-- ========== АИМ ==========
local function isPlayerVisible(targetPart)
    if not State.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Head") then origin = char.Head.Position end
    local dir = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, dir, params)
    if result then return result.Instance:IsDescendantOf(targetPart.Parent) end
    return true
end

local function getTarget()
    local center = Camera.ViewportSize / 2
    local best, bestDist = nil, aimFovSize
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 and isPlayerVisible(head) then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < bestDist then best, bestDist = head, d end
                end
            end
        end
    end
    return best
end

local function getTargetUnderCrosshair()
    local char = LocalPlayer.Character
    if not char then return nil end
    local origin = Camera.CFrame.Position
    local dir = Camera.CFrame.LookVector * 500
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, dir, params)
    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model then
            local plr = Players:GetPlayerFromCharacter(model)
            if plr and plr ~= LocalPlayer then
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then return plr end
            end
        end
    end
    return nil
end

-- ========== ВИЗУАЛ ==========
local function applyChams(p)
    if p == LocalPlayer or not p.Character then return end
    local h = p.Character:FindFirstChild("DH_Chams")
    if State.Chams then
        if not h then
            h = Instance.new("Highlight", p.Character)
            h.Name = "DH_Chams"
            h.Adornee = p.Character
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end
        h.FillColor = chamsColor
        h.OutlineColor = chamsColor
        h.FillTransparency = chamsTransparency
        h.OutlineTransparency = 0
    elseif h then
        h:Destroy()
    end
end

local function applyHighlight(p)
    if p == LocalPlayer or not p.Character then return end
    local h = p.Character:FindFirstChild("DH_HL")
    if State.Highlight then
        if not h then
            h = Instance.new("Highlight", p.Character)
            h.Name = "DH_HL"
            h.Adornee = p.Character
            h.DepthMode = Enum.HighlightDepthMode.Occluded
        end
        h.FillColor = ACCENT
        h.OutlineColor = WHITE
        h.FillTransparency = 0.6
    elseif h then
        h:Destroy()
    end
end

local function refreshVisuals()
    for _, p in ipairs(Players:GetPlayers()) do
        applyHighlight(p)
        applyChams(p)
    end
end

local function recolorChams()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local h = p.Character:FindFirstChild("DH_Chams")
            if h then
                h.FillColor = chamsColor
                h.OutlineColor = chamsColor
                h.FillTransparency = chamsTransparency
            end
        end
    end
end

local function hookPlayer(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        applyHighlight(p)
        applyChams(p)
    end)
end
for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
Players.PlayerAdded:Connect(hookPlayer)

-- ========== 3-е ЛИЦО ==========
local function applyThirdPerson()
    if not LocalPlayer.Character then return end
    if State.ThirdPerson then
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance = 8
        LocalPlayer.CameraMaxZoomDistance = 20
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            Camera.CameraSubject = hum
            Camera.CameraType = Enum.CameraType.Custom
        end
    else
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 0.5
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then Camera.CameraSubject = hum end
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.6)
    applyThirdPerson()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = not State.Spin end
    task.wait(0.3)
    refreshVisuals()
end)

