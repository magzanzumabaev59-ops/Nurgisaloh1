-- СКИНЧЕНДЖЕР НОЖА
-- ============================================
local knifeOriginals = {}

local function resetKnifeSkin()
    for part, data in pairs(knifeOriginals) do
        if part.Parent then
            part.Color = data.c
            part.Material = data.m
            part.Transparency = data.t
        end
    end
    knifeOriginals = {}
end

local function applyKnifeSkin(color, material, transparency)
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    resetKnifeSkin()
    for _, part in ipairs(tool:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("MeshPart") then
            knifeOriginals[part] = {c = part.Color, m = part.Material, t = part.Transparency}
            part.Color = color
            part.Material = material
            if transparency then part.Transparency = transparency end
        end
    end
end

